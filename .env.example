# Server (Docker):
#   cp .env.example .env
#   qiymatlarni o'zgartiring
#   docker compose up -d --build
#
# Lokal Maven (Docker siz):
#   SPRING_PROFILES_ACTIVE=dev
#   DB_URL=jdbc:postgresql://localhost:5432/urspi_db
#   REDIS_HOST=localhost

SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

POSTGRES_DB=urspi_db
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-db-password

JWT_SECRET=change-me-use-at-least-32-byte-secret!!
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

FILE_UPLOAD_DIR=/app/uploads

APP_SEED_ENABLED=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin-password

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://new.urspi.uz,https://new.urspi.uz
